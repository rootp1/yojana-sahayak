# AI chat assistant (Vercel AI Gateway). Without it, chat falls back to keyword search results.
# On Vercel, OIDC auth is automatic once AI Gateway is enabled for the project.
AI_GATEWAY_API_KEY=

# Optional: override the chat model (any AI Gateway model id)
# CHAT_MODEL=anthropic/claude-sonnet-5.5

# Optional: server speech-to-text for browsers without built-in voice typing (Sarvam AI, Indic STT)
SARVAM_API_KEY=
# SARVAM_STT_MODEL=saarika:v2.5
